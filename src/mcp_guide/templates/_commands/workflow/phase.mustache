---
type: agent/instruction
aliases: ["phase"]
description: "Transition to a specific workflow phase"
usage: "guide://_workflow/phase/<phase-name>"
category: "project-workflow"
requires-workflow: true
includes:
  - "../_partials/workflow-status"
  - "../_partials/phase-transitions"
instruction: >
  {{#args.0.value}}Update the phase field in {{workflow.file}} according to the instructions provided to `{{args.0.value}}`.{{/args.0.value}}{{^args.0.value}}{{#kwargs.phase}}Update the phase field in {{workflow.file}} according to the instructions provided to `{{kwargs.phase}}`.{{/kwargs.phase}}{{^kwargs.phase}}Display the current value of the phase field in {{workflow.file}}.{{/kwargs.phase}}{{/args.0.value}}
elicitation:
  workflow-phase:
    message: "{{#workflow.phase}}The current phase is `{{workflow.phase}}`. {{/workflow.phase}}Choose the phase to enter."
    fallback: render
    schema:
      type: object
      properties:
        phase:
          type: string
          description: A phase enabled for this project, other than the current phase.
          source: workflow-phases
      required: [phase]
