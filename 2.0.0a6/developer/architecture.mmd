```mermaid
---
config:
  theme: default
  look: neo
---
flowchart TB
    Client["MCP client"] --> Server

    subgraph Server["FastMCP Server"]
        ToolRegistration["Tool registration\nExtMcpToolDecorator"]
        PromptRegistration["Prompt registration\npromptfunc"]
        ResourceRegistration["Resource registration\nresourcefunc"]
        NativeResponses["Native SDK responses\nToolResult · PromptResult · ResourceResult"]
    end

    Server -->|lifespan| Runtime
    ToolRegistration -->|invocation and project-bound check| SessionResolver
    PromptRegistration -->|invocation| SessionResolver
    ResourceRegistration -->|URI request| SessionResolver
    ToolRegistration --> NativeResponses
    PromptRegistration --> NativeResponses
    ResourceRegistration --> NativeResponses

    subgraph Runtime["GuideRuntime — process-global lifecycle and shared state"]
        ConfigManager["ConfigManager\nconfiguration cache · watcher · shared update publication\ndocroot resolved at runtime start"]
        SessionManager["Session manager\nruntime owner-key → Session registry\nidle-session expiry"]
        SessionResolver["Session resolver\nFastMCP request context + optional session_id"]
        Session["Session — per client interaction\nproject root · active configuration · agent metadata"]
        TaskManager["TaskManager — per Session\ntask lifecycle · event subscriptions · instruction queue\nresult processing"]

        SessionResolver --> SessionManager
        SessionManager -->|creates / returns| Session
        ConfigManager -->|injected into| Session
        Session -->|owns| TaskManager
        ConfigManager -->|configuration delta| Session
    end

    ToolRegistration -->|on_tool| TaskManager
    ToolRegistration -->|Result → tool_result → process_result| TaskManager
    PromptRegistration -->|on_tool and prompt_result| TaskManager
    ResourceRegistration -->|process_result| TaskManager

    subgraph Tools["Registered tools"]
        direction TB

        subgraph ProjectTools["Project tools — Session binding and ConfigManager-backed project configuration"]
            GetProject["get_project"]
            SetProject["set_project"]
            SwitchProject["switch_project"]
            ListProjects["list_projects"]
            ListProject["list_project"]
            CloneProject["clone_project"]
            UseProjectProfile["use_project_profile"]
            ListProfiles["list_profiles"]
            ShowProfile["show_profile"]
            AddPermissionPath["add_permission_path"]
            RemovePermissionPath["remove_permission_path"]
        end

        subgraph ContentTools["Content tools — Session project configuration, document rendering, TaskManager result handling"]
            GetContent["get_content"]
            ExportContent["export_content"]
            ListExports["list_exports"]
            RemoveExport["remove_export"]
            CategoryListFiles["category_list_files"]
            CategoryContent["category_content"]
            CategoryCollectionList["category_collection_list"]
            CategoryCollectionRemove["category_collection_remove"]
            CategoryCollectionAdd["category_collection_add"]
            CategoryCollectionChange["category_collection_change"]
            CategoryCollectionUpdate["category_collection_update"]
            DocumentRemove["document_remove"]
            DocumentUpdate["document_update"]
            UpdateDocuments["update_documents"]
            ReadResource["read_resource"]
        end

        subgraph FeatureFlagTools["Feature-flag tools — Session → ConfigManager, TaskManager result handling"]
            ListProjectFlags["list_project_flags"]
            SetProjectFlag["set_project_flag"]
