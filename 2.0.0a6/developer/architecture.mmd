            ClientInfo["client_info"]
        end
    end

    ProjectTools -->|bind, select, and persist configuration| Session
    ContentTools -->|project configuration and document context| Session
    FeatureFlagTools -->|read and mutate flags| Session
    FilesystemTools -->|resolve request Session| Session
    UtilityTools -->|read client metadata| Session
    DiscoveryTools -->|inspect registries| ToolRegistration
    FilesystemTools -->|filesystem events| TaskManager

    subgraph Prompts["Registered prompts"]
        GuidePrompt["guide\nSession resolution · command/content routing\nTaskManager on_tool + prompt_result"]
    end
    GuidePrompt --> SessionResolver
    GuidePrompt --> TaskManager

    subgraph Resources["Registered resources"]
        GuideResource["guide://{collection}/{document}{?session_id}\nSession content lookup · TaskManager process_result"]
        GuideCommandResource["guide://_{command_path*}{?session_id}\nSession command-resource lookup · TaskManager process_result"]
    end
    GuideResource --> SessionResolver
    GuideResource --> TaskManager
    GuideCommandResource --> SessionResolver
    GuideCommandResource --> TaskManager
